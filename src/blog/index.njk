---
layout: layouts/base.njk
title: blog
---

<h1>{{ title }}</h1>

<div class="post-list">
  {% for post in collections.posts | reverse %}
  <div class="post">
    <h2>
      <a href="{{ post.url }}">{{ post.data.title }}</a>
    </h2>
    <p class="subtitle">Published on {{ post.date | readableDate }}</p>
    </p>
    {% if post.data.description %}
    <p>{{ post.data.description }}</p>
    {% endif %}
  </div>
  {% endfor %}
</div>